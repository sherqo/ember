#!/usr/bin/env bash
# Ember — warm little audio mixer (TUI).
# Output/mic levels, sink/source picker, per-app volumes. Pure wpctl.
# Keys: +/- volume · m mute · enter select/mute · r refresh · q/esc quit.
set -u

BAR_W=10

bar() { # pct -> blocks
  local pct=$1
  (( pct < 0 )) && pct=0
  (( pct > 100 )) && pct=100
  local n=$(( pct * BAR_W / 100 )) i out=""
  for (( i = 0; i < n; i++ )); do out+="█"; done
  for (( ; i < BAR_W; i++ )); do out+="░"; done
  printf '%s' "$out"
}

vol_of() { # id -> "pct muted"
  local out pct muted=0
  out=$(wpctl get-volume "$1" 2>/dev/null) || { echo "0 0"; return; }
  pct=$(awk '{printf "%d", $2 * 100}' <<<"$out")
  [[ $out == *MUTED* ]] && muted=1
  echo "$pct $muted"
}

# kind | id | name | bar | pct | state
row() { # kind id name
  local pct muted state=""
  read -r pct muted < <(vol_of "$2")
  (( muted == 1 )) && state="MUTED"
  printf '%s\t%s\t%s\t%s\t%s%%\t%s\n' "$1" "$2" "$3" "$(bar "$pct")" "$pct" "$state"
}

section_nodes() { # section-name -> "id|name" lines
  awk -v sec="$1" '
    $0 ~ /^ ├─ / { cur="" }
    $0 ~ "├─ "sec { cur=sec; next }
    cur != "" && $0 ~ /│ *[0-9]+\. / {
      line=$0
      sub(/^[^0-9]*/, "", line)
      id=line; sub(/\..*/, "", id)
      name=line; sub(/^[0-9]+\. */, "", name); sub(/ \[vol:.*/, "", name)
      gsub(/^ +| +$/, "", name)
      print id"|"name
    }' < <(wpctl status 2>/dev/null)
}

gen_list() {
  local sink src nid name
  sink=$(pactl get-default-sink 2>/dev/null || echo "?")
  src=$(pactl get-default-source 2>/dev/null || echo "?")

  row OUTPUT "@DEFAULT_AUDIO_SINK@" "$sink"
  row INPUT "@DEFAULT_AUDIO_SOURCE@" "$src"

  while IFS='|' read -r nid name; do
    [[ -z $nid ]] && continue
    row SINK "$nid" "$name"
  done < <(section_nodes "Sinks")

  while IFS='|' read -r nid name; do
    [[ -z $nid ]] && continue
    row SOURCE "$nid" "$name"
  done < <(section_nodes "Sources")

  while IFS='|' read -r nid name; do
    [[ -z $nid ]] && continue
    row STREAM "$nid" "$name"
  done < <(section_nodes "Streams")
}

ME="$0"

do_activate() { # kind node
  case "$1" in
  SINK | SOURCE) wpctl set-default "$2" 2>/dev/null ;;
  STREAM | OUTPUT | INPUT) wpctl set-mute "$2" toggle 2>/dev/null ;;
  esac
}

case "${1:-}" in
--dump) gen_list; exit 0 ;;
--activate) do_activate "$2" "$3"; exit 0 ;;
--help | -h) sed -n '2,5p' "$0"; exit 0 ;;
esac

fzf --with-nth=1,3,4,5,6 \
  --delimiter=$'\t' \
  --prompt="ember> " \
  --header="Ember · +/- volume · m mute · enter select/mute · r refresh" \
  --layout=reverse --info=hidden \
  --color="bg:#202330,fg:#FFF0F5,hl:#FF4C7A,fg+:#FFF0F5,bg+:#565970,hl+:#FF7F9D,prompt:#C77DFF,header:#565970" \
  --bind "+:execute-silent(wpctl set-volume {2} 5%+)+reload($ME --dump)" \
  --bind "-:execute-silent(wpctl set-volume {2} 5%-)+reload($ME --dump)" \
  --bind "m:execute-silent(wpctl set-mute {2} toggle)+reload($ME --dump)" \
  --bind "r:reload($ME --dump)" \
  --bind "enter:execute-silent($ME --activate {1} {2})+reload($ME --dump)" \
  < <(gen_list) >/dev/null
exit 0
